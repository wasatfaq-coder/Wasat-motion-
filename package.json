{
  "name": "wasat-motion",
  "version": "1.0.0",
  "description": "Вертикальные моушн-эксплейнеры для Shorts на Remotion",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasatfaq-coder/Wasat-motion-"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/install-whisper-cpp": "4.0.542",
    "@remotion/layout-utils": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/motion-blur": "4.0.542",
    "@remotion/noise": "4.0.542",
    "@remotion/paths": "4.0.542",
    "@remotion/sfx": "4.0.542",
    "@remotion/shapes": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "@remotion/zod-types": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "review-video": "node scripts/review-video.mjs",
    "lines": "node scripts/lines-check.mjs",
    "test": "node scripts/regress-checks.mjs && node scripts/audit.mjs && for d in projects/*/; do [ -d \"$d\" ] || continue; slug=$(basename \"$d\"); echo \"== $slug\"; node scripts/audit.mjs --scenes \"src/projects/$slug/scenes\" --content \"projects/$slug/content\" --timeline \"src/projects/$slug/data/timeline.json\"; done && node scripts/handed-check.mjs && node scripts/selftest-new-topic.mjs",
    "style": "node scripts/style-check.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
